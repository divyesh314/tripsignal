# Copy to .env.local and adjust
DATABASE_URL=postgres://tripsignal:tripsignal@localhost:5432/tripsignal
MONGODB_URL=mongodb://localhost:27017/tripsignal

# Long random string used to sign login cookies
AUTH_SECRET=change-me-to-a-long-random-string

# live = call the real free APIs; mock = use built-in sample data (offline demos)
SOURCE_MODE=live
# Only used when SOURCE_MODE=mock: green | orange | red
MOCK_SCENARIO=orange

# NWS asks every client to identify itself with contact details
NWS_USER_AGENT=TripSignal prototype (you@example.com)

# Protects /api/cron/recheck (hourly re-checks). Use a long random string.
CRON_SECRET=change-me-too
